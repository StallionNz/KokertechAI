# =============================================================================
# KokertechAI - Environment Configuration (.env.example)
# =============================================================================
# Copy this file to .env to configure the application:
#   copy .env.example .env
#
# The .env file is loaded at startup by config.py (_load_dotenv).
# Existing OS-level environment variables take priority and are NEVER
# overridden by values in this file.
# =============================================================================


# -- AI Provider --------------------------------------------------------------

# API key for your AI provider (LM Studio, OpenRouter, Jan, etc.)
# On first load, the key is migrated to Windows Credential Manager (keyring)
# for secure storage. After migration, keyring takes priority over this file.
#
# For LM Studio (local):     Leave empty (no auth needed for localhost)
# For OpenRouter (cloud):    Set to your API key, e.g. sk-or-v1-...
#KOKERTECH_API_KEY=

# API endpoint URL (optional override).
# Default (from app_settings.json): http://127.0.0.1:1234/v1/chat/completions
#
# Only set this if you need to use a different provider or port:
#   Ollama:     http://127.0.0.1:11434/api/chat
#   OpenRouter: https://openrouter.ai/api/v1/chat/completions
#   Remote:     http://192.168.1.100:1234/v1/chat/completions
#KOKERTECH_API_URL=


# -- Testing / Development ----------------------------------------------------

# Set to 1 to skip sentence-transformers embedding generation.
# Used automatically by conftest.py during pytest runs.
# Set manually to speed up cold starts or when running headless.
#KOKERTECH_SKIP_EMBEDDINGS=1


# =============================================================================
# Notes
# =============================================================================
# - Lines starting with # are comments. Uncomment to activate a line.
# - Format: KEY=VALUE (no spaces around =)
# - Values can be quoted with " or ' if they contain special characters
# - Booleans: Use 1/0 or true/false
# - API keys stored in Windows Credential Manager take priority over .env
# - All data files resolve relative to C:\KokertechAI (hardcoded in config.py)
#
# Generated by KokertechAI v4.0 | June 2026
